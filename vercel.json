{
  "headers": [
    {
      "source": "/storage/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/storage/:path*",
      "destination": "https://wrkoyhjzgxyexyfmwnwb.supabase.co/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}